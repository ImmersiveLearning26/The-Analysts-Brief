{
  "name": "analysts-brief-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "The Analyst's Brief: spatial Three.js simulation with a compact agent interface",
  "scripts": {
    "assets": "node scripts/copy-assets.mjs",
    "dev": "npm run assets && vite --host 127.0.0.1 --port 5180",
    "build": "npm run assets && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 5181",
    "test:rules": "node ../verification/rules.test.mjs",
    "test:spatial": "node ../verification/spatial.test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/afacad": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "three": "0.187.0"
  },
  "devDependencies": {
    "vite": "8.3.8"
  }
}
